# DeepSeek（OpenAI 兼容接口）配置，换成你自己的 key
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4.1-flash

# 景点与旅行偏好的向量匹配；EMBEDDING_API_KEY 留空时复用 OPENAI_API_KEY。
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=

# 高德 Web 服务 key（控制台 → 应用管理 → 服务平台选「Web服务」），用于地点坐标和路线
AMAP_KEY=your-amap-web-service-key
