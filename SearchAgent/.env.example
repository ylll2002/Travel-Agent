# 千问（Qwen）OpenAI 兼容接口配置，换成你自己的 key
# DashScope 兼容模式端点，免费模型可选 qwen-turbo / qwen3-flash
OPENAI_API_KEY=sk-your-qwen-key-here
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4-flash-0731

# Tavily 通用网页搜索（活动/促销等仍在用，可选），去 https://app.tavily.com 生成
TAVILY_API_KEY=tvly-your-key-here

# 高德 Web 服务 Key（控制台 → 应用管理 → 服务平台选「Web服务」）
# 用于餐厅 POI 搜索（餐饮搜索智能体）
AMAP_KEY=your-amap-web-service-key
