APP_NAME=TravelAgent API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api
DATABASE_URL=sqlite:///./travelagent.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== LangGraph & LLM 配置 =====
# 获取 OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 如果使用第三方 API（兼容 OpenAI 格式），设置 base_url
# 例如: https://api.deepseek.com/v1 或 http://localhost:11434/v1
OPENAI_API_BASE=

OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4000

# ===== 可选：使用其他 LLM 提供商 =====
# 如果没有 OpenAI key，可以用以下替代方案：
# 1. Ollama（本地免费）: https://ollama.ai/
# 2. DeepSeek（便宜）: https://platform.deepseek.com/
# 3. Groq（免费额度）: https://console.groq.com/

